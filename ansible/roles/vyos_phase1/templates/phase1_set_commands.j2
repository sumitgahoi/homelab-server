{# VyOS 1.4+ style (sagitta / current rolling). Adjust if you run 1.3.x. #}
set interfaces ethernet {{ vyos_wan_if }} address 'dhcp'
set interfaces ethernet {{ vyos_lan_if }} address '{{ vyos_lan_ipv4 }}/{{ vyos_lan_prefix }}'
set service dhcp-server shared-network-name {{ vyos_dhcp_shared_network }} authoritative
set service dhcp-server shared-network-name {{ vyos_dhcp_shared_network }} subnet {{ vyos_lan_network }} default-router '{{ vyos_lan_ipv4 }}'
set service dhcp-server shared-network-name {{ vyos_dhcp_shared_network }} subnet {{ vyos_lan_network }} range 0 start '{{ vyos_dhcp_range_start }}'
set service dhcp-server shared-network-name {{ vyos_dhcp_shared_network }} subnet {{ vyos_lan_network }} range 0 stop '{{ vyos_dhcp_range_stop }}'
{% for ns in phase1_dns_map[phase1_dns_provider] %}
set service dhcp-server shared-network-name {{ vyos_dhcp_shared_network }} subnet {{ vyos_lan_network }} name-server '{{ ns }}'
{% endfor %}
set nat source rule 100 outbound-interface name '{{ vyos_wan_if }}'
set nat source rule 100 translation address 'masquerade'
{% for ns in phase1_dns_map[phase1_dns_provider] %}
set system name-server '{{ ns }}'
{% endfor %}
