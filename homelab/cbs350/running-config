! CBS350-24FP-4G Git desired state (L2 + management).
! Equivalent of VyOS config.boot: `show running-config` / `show startup-config`.
! This file is not a verbatim live dump: no firmware header, SSD block, or passwords.
! Incremental CLI does not delete omitted nodes. Apply from factory: commands.txt
! Live dump (operator): show running-config   then copy running-config startup-config
! Do not put enable/user hashes in Git.

hostname cbs350
macro auto disabled
no ip routing

vlan database
vlan 10 name private
vlan 20 name guest
vlan 30 name iot
vlan 40 name india
exit

! Pin the factory hatch as a real static before adding 10.10.10.2 (otherwise .254 vanishes).
interface vlan 1
 ip address 192.168.1.254 255.255.255.0
 no ip address dhcp
exit

interface vlan 10
 ip address 10.10.10.2 255.255.255.0
exit

ip default-gateway 10.10.10.1
ip ssh server

interface gi1
 description "Proxmox nic0 LAN trunk"
 switchport mode trunk
 switchport trunk native vlan 1
 switchport trunk allowed vlan 10,20,30,40
exit

interface gi2
 description "UniFi U6+ (not installed)"
 switchport mode trunk
 switchport trunk native vlan 1
 switchport trunk allowed vlan 10,20,30,40
exit

interface range gi3-12
 switchport mode access
 switchport access vlan 10
exit

interface gi3
 description BMC
exit
interface gi4
 description "spare trusted (NAS deferred)"
exit
interface gi5
 description PS5
exit
interface gi6
 description "Apple TV"
exit
interface gi7
 description "Switch 2"
exit
interface gi12
 description "admin OOB — do not repurpose"
exit

interface range gi13-22
 description IoT
 switchport mode access
 switchport access vlan 30
exit

interface range gi23-24
 description India
 switchport mode access
 switchport access vlan 40
exit

! SFP cages. Names were gi25-28 on this chassis; confirm with show interfaces status.
interface range gi25-28
 shutdown
exit
