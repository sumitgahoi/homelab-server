/* Authoritative VyOS configuration. Dialect: rolling 2026.09.09-0029-rolling.
   Apply: ansible-playbook vyos/01-config.yml
   Templated: SSH public key from homelab/ansible/ssh/macbook.pub */

interfaces {
    ethernet eth0 {
        description "LAN trunk"
        hw-id 02:00:00:00:00:00
        vif 10 {
            address 10.10.10.1/24
            description "VLAN 10 trusted"
        }
        vif 20 {
            address 10.10.20.1/24
            description "VLAN 20 guest"
        }
        vif 30 {
            address 10.10.30.1/24
            description "VLAN 30 iot"
        }
        vif 40 {
            address 10.10.40.1/24
            description "VLAN 40 india"
        }
    }
    ethernet eth1 {
        address dhcp
        description "WAN"
        hw-id 02:00:00:00:00:01
    }
    ethernet eth2 {
        address 10.10.0.1/24
        description "services"
        hw-id 02:00:00:00:00:02
    }
}
service {
    ssh {
        disable-host-validation
    }
    dns {
        forwarding {
            listen-address 10.10.10.1
            listen-address 10.10.20.1
            listen-address 10.10.30.1
            listen-address 10.10.40.1
            allow-from 10.10.10.0/24
            allow-from 10.10.20.0/24
            allow-from 10.10.30.0/24
            allow-from 10.10.40.0/24
            name-server 1.1.1.1
            name-server 1.0.0.1
        }
    }
    dhcp-server {
        shared-network-name PRIVATE {
            authoritative
            subnet 10.10.10.0/24 {
                subnet-id 10
                option {
                    default-router 10.10.10.1
                    name-server 10.10.10.1
                    domain-name homelab.local
                }
                range 0 {
                    start 10.10.10.100
                    stop 10.10.10.250
                }
            }
        }
        shared-network-name GUEST {
            authoritative
            subnet 10.10.20.0/24 {
                subnet-id 20
                option {
                    default-router 10.10.20.1
                    name-server 10.10.20.1
                }
                range 0 {
                    start 10.10.20.100
                    stop 10.10.20.250
                }
            }
        }
        shared-network-name IOT {
            authoritative
            subnet 10.10.30.0/24 {
                subnet-id 30
                option {
                    default-router 10.10.30.1
                    name-server 10.10.30.1
                }
                range 0 {
                    start 10.10.30.100
                    stop 10.10.30.250
                }
            }
        }
        shared-network-name INDIA {
            authoritative
            subnet 10.10.40.0/24 {
                subnet-id 40
                option {
                    default-router 10.10.40.1
                    name-server 10.10.40.1
                }
                range 0 {
                    start 10.10.40.100
                    stop 10.10.40.250
                }
            }
        }
    }
}
nat {
    source {
        rule 100 {
            description "NAT trusted to WAN"
            outbound-interface {
                name eth1
            }
            source {
                address 10.10.10.0/24
            }
            translation {
                address masquerade
            }
        }
        rule 110 {
            description "NAT guest to WAN"
            outbound-interface {
                name eth1
            }
            source {
                address 10.10.20.0/24
            }
            translation {
                address masquerade
            }
        }
    }
}
firewall {
    group {
        network-group NET-PRIVATE {
            network 10.10.10.0/24
        }
        network-group NET-GUEST {
            network 10.10.20.0/24
        }
        network-group NET-IOT {
            network 10.10.30.0/24
        }
        network-group NET-INDIA {
            network 10.10.40.0/24
        }
        network-group NET-INTERNAL {
            network 10.10.10.0/24
            network 10.10.20.0/24
            network 10.10.30.0/24
            network 10.10.40.0/24
            network 10.10.0.0/24
        }
        port-group MGMT-PORTS {
            port 22
        }
        interface-group IF-INTERNAL {
            interface eth0.10
            interface eth0.20
            interface eth0.30
            interface eth0.40
            interface eth2
        }
        interface-group IF-DHCP-SERVER {
            interface eth0.10
            interface eth0.20
            interface eth0.30
            interface eth0.40
        }
    }
    ipv4 {
        input {
            filter {
                default-action drop
                rule 10 {
                    action accept
                    state established
                    state related
                }
                rule 20 {
                    action accept
                    description "WAN DHCP client"
                    inbound-interface {
                        name eth1
                    }
                    protocol udp
                    destination {
                        port 68
                    }
                }
                rule 30 {
                    action accept
                    description "ICMP from internal"
                    protocol icmp
                    inbound-interface {
                        group IF-INTERNAL
                    }
                }
                rule 40 {
                    action accept
                    description "DHCP server"
                    protocol udp
                    destination {
                        port 67
                    }
                    inbound-interface {
                        group IF-DHCP-SERVER
                    }
                }
                rule 100 {
                    action accept
                    source {
                        group {
                            network-group NET-PRIVATE
                        }
                    }
                    destination {
                        port 53
                    }
                    protocol tcp
                }
                rule 101 {
                    action accept
                    source {
                        group {
                            network-group NET-PRIVATE
                        }
                    }
                    destination {
                        port 53
                    }
                    protocol udp
                }
                rule 110 {
                    action accept
                    source {
                        group {
                            network-group NET-GUEST
                        }
                    }
                    destination {
                        port 53
                    }
                    protocol tcp
                }
                rule 111 {
                    action accept
                    source {
                        group {
                            network-group NET-GUEST
                        }
                    }
                    destination {
                        port 53
                    }
                    protocol udp
                }
                rule 120 {
                    action accept
                    source {
                        group {
                            network-group NET-IOT
                        }
                    }
                    destination {
                        port 53
                    }
                    protocol tcp
                }
                rule 121 {
                    action accept
                    source {
                        group {
                            network-group NET-IOT
                        }
                    }
                    destination {
                        port 53
                    }
                    protocol udp
                }
                rule 130 {
                    action accept
                    source {
                        group {
                            network-group NET-INDIA
                        }
                    }
                    destination {
                        port 53
                    }
                    protocol tcp
                }
                rule 131 {
                    action accept
                    source {
                        group {
                            network-group NET-INDIA
                        }
                    }
                    destination {
                        port 53
                    }
                    protocol udp
                }
                rule 200 {
                    action drop
                    source {
                        group {
                            network-group NET-GUEST
                        }
                    }
                    destination {
                        group {
                            port-group MGMT-PORTS
                        }
                    }
                    protocol tcp
                }
                rule 210 {
                    action drop
                    source {
                        group {
                            network-group NET-IOT
                        }
                    }
                    destination {
                        group {
                            port-group MGMT-PORTS
                        }
                    }
                    protocol tcp
                }
                rule 220 {
                    action drop
                    source {
                        group {
                            network-group NET-INDIA
                        }
                    }
                    destination {
                        group {
                            port-group MGMT-PORTS
                        }
                    }
                    protocol tcp
                }
                rule 1000 {
                    action accept
                    description "trusted to VyOS"
                    source {
                        group {
                            network-group NET-PRIVATE
                        }
                    }
                }
            }
        }
        forward {
            filter {
                default-action drop
                rule 10 {
                    action accept
                    state established
                    state related
                }
                rule 100 {
                    action accept
                    description "trusted unrestricted"
                    source {
                        group {
                            network-group NET-PRIVATE
                        }
                    }
                }
                rule 200 {
                    action accept
                    description "guest to WAN"
                    source {
                        group {
                            network-group NET-GUEST
                        }
                    }
                    outbound-interface {
                        name eth1
                    }
                }
                rule 210 {
                    action drop
                    source {
                        group {
                            network-group NET-GUEST
                        }
                    }
                    destination {
                        group {
                            network-group NET-INTERNAL
                        }
                    }
                }
                rule 320 {
                    action drop
                    source {
                        group {
                            network-group NET-IOT
                        }
                    }
                    destination {
                        group {
                            network-group NET-PRIVATE
                        }
                    }
                }
                rule 321 {
                    action drop
                    source {
                        group {
                            network-group NET-IOT
                        }
                    }
                    destination {
                        group {
                            network-group NET-GUEST
                        }
                    }
                }
                rule 322 {
                    action drop
                    source {
                        group {
                            network-group NET-IOT
                        }
                    }
                    destination {
                        group {
                            network-group NET-INDIA
                        }
                    }
                }
                rule 330 {
                    action drop
                    source {
                        group {
                            network-group NET-IOT
                        }
                    }
                    outbound-interface {
                        name eth1
                    }
                }
                rule 500 {
                    action drop
                    source {
                        group {
                            network-group NET-INDIA
                        }
                    }
                    outbound-interface {
                        name eth1
                    }
                }
                rule 510 {
                    action drop
                    source {
                        group {
                            network-group NET-INDIA
                        }
                    }
                    destination {
                        group {
                            network-group NET-INTERNAL
                        }
                    }
                }
                rule 520 {
                    action drop
                    source {
                        group {
                            network-group NET-INDIA
                        }
                    }
                    destination {
                        port 853
                    }
                    protocol tcp
                }
                rule 530 {
                    action drop
                    source {
                        group {
                            network-group NET-INDIA
                        }
                    }
                    destination {
                        port 53
                    }
                    protocol tcp
                }
                rule 531 {
                    action drop
                    source {
                        group {
                            network-group NET-INDIA
                        }
                    }
                    destination {
                        port 53
                    }
                    protocol udp
                }
            }
        }
    }
}
system {
    config-management {
        commit-confirm {
            action reload
        }
    }
    login {
        user vyos {
            authentication {
                public-keys macbook {
                    type '{{ vyos_ssh_key_type }}'
                    key '{{ vyos_ssh_key_body }}'
                }
            }
        }
    }
}
