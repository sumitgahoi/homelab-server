# Known-good /etc/network/interfaces until cutover. Live on pve.
# Host mgmt is 192.168.50.200 on vmbr1 only.
# No vmbr0.10 until switching to `interfaces`.
# A human copies this file, then ifreload. Do not use the Network UI Apply button.

auto lo
iface lo inet loopback

auto nic0
iface nic0 inet manual

auto nic1
iface nic1 inet manual

# ASUS LAN. Host mgmt until VyOS is the default router.
auto vmbr1
iface vmbr1 inet static
    address 192.168.50.200/24
    gateway 192.168.50.1
    bridge-ports nic1
    bridge-stp off
    bridge-fd 0

# LAN trunk: CBS350 GE1 → nic0. Tagged 10/20/30/40 pass through.
# No host IP on the bridge itself (that would be untagged).
auto vmbr0
iface vmbr0 inet manual
    bridge-ports nic0
    bridge-stp off
    bridge-fd 0
    bridge-vlan-aware yes
    bridge-vids 10 20 30 40

auto vmbr-svc
iface vmbr-svc inet manual
    bridge-ports none
    bridge-stp off
    bridge-fd 0

source /etc/network/interfaces.d/*
